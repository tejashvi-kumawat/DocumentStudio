#!/bin/sh
# Remove untracked engine trees (LibreOffice version dirs, user drops) after dpkg
# deletes only files listed in the package manifest.
set -e

APP_DIR=/usr/lib/document-studio
DESKTOP=/usr/share/applications/com.documentstudio.document_studio.desktop
LAUNCHER=/usr/bin/document_studio

case "$1" in
  remove|purge)
    rm -rf "$APP_DIR"
    rm -f "$LAUNCHER" "$DESKTOP"
    if command -v update-desktop-database >/dev/null 2>&1; then
      update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
    fi
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
      gtk-update-icon-cache -f /usr/share/icons/hicolor >/dev/null 2>&1 || true
    fi
    ;;
  upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
    ;;
esac

exit 0
