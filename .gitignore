# Local tooling (e.g. portable qpdf for corpus generator)
.tools/

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Release / packaging outputs
*.AppImage
*.AppDir/
AppDir/
*-AppDir.tar.gz
.flutter-plugins
**/engines/lib/
# Flatpak local build staging (hardlink clone of dist AppDir; do not commit)
linux/packaging/flatpak/AppDir/

# Signing & secrets — never commit
**/key.properties
**/KEYSTORE_BACKUP.txt
android/KEYSTORE_BACKUP.txt
**/*.jks
**/*.keystore
**/*.p12
**/*.pfx
**/*.mobileprovision
**/AuthKey_*.p8
android/upload-keystore.jks

# Large local binaries (do not commit)
qpdf_*.deb
*.deb
dist/

# Local PDF stress files (see benchmarks/README.md). Do not commit.
/benchmarks/*.pdf

# Large local PDF benchmarks (do not commit)
benchmarks/*.pdf
